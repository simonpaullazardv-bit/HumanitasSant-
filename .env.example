# HUMANITASBD — exemple sans secrets réels.
# Copiez vers .env.local et renseignez les valeurs locales.

# Navigateur / Vite : uniquement la clé publishable (ou anon quand elle sera disponible).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
# URL publique utilisée pour encoder les QR de cartes. Ne pas inventer : renseigner uniquement après validation du domaine.
VITE_PUBLIC_SITE_URL=https://YOUR_PUBLIC_DOMAIN
# VITE_SUPABASE_ANON_KEY=

# Serveur uniquement : jamais de préfixe VITE_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
